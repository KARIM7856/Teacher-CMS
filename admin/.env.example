# Supabase credentials for the admin portal.
# Vite exposes only variables prefixed with VITE_ to the client bundle.
# Copy this file to .env and fill in your project's values.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server-side only (the /api/students serverless function) ──────────────────
# These are NOT prefixed with VITE_, so they are never bundled into the browser.
# In production set them in the Vercel project's Environment Variables.
# The service_role key bypasses RLS — keep it secret, never commit a real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Synthetic email domain for username-based student logins.
# MUST match kStudentEmailDomain in the Flutter app (app/lib/src/core/config/auth_config.dart).
STUDENT_EMAIL_DOMAIN=students.teachercms.app
