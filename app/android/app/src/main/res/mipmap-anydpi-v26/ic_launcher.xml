<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). The launcher masks these two layers to
     whatever shape the device theme uses, so the art must survive a circle, a
     squircle and a teardrop alike — the book is kept inside the 66% safe zone by
     tools/generate_app_icons.mjs.

     <monochrome> is the themed-icon layer for Android 13+; older releases ignore
     the element. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
